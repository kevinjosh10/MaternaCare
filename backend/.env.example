# MaternaCare Environment Configuration

PROJECT_NAME="MaternaCare Backend & Voice-to-Voice AI"
API_V1_STR="/api/v1"
SECRET_KEY="maternacare-super-secret-jwt-key-change-in-production"
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Database
# Default fallback to SQLite for immediate zero-config local testing if Postgres is not running
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/maternacare_db"
SQLITE_FALLBACK="True"

# CORS
BACKEND_CORS_ORIGINS=["http://localhost:3000","http://localhost:8000","*"]

# AI & Voice Engine Configuration
VOICE_ASR_MODEL="whisper-base-multilingual"
VOICE_TTS_ENGINE="neural-maternacare-tts"
VOICE_SUPPORTED_LANGUAGES="en,hi,ta,te,kn,bn,mr,es,fr,sw"
DEFAULT_VOICE_LANGUAGE="hi"

# Storage
UPLOAD_DIR="./uploads"
MAX_UPLOAD_SIZE_MB=25
